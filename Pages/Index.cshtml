                    </a>
                    <a href="~/pdf/gamex-oferta.pdf" class="btn-gamex btn-secondary-gamex btn-lg" download="Oferta-GAMEX.pdf">
                        <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-file-pdf"></use></svg>Pobierz ofertę PDF
                    </a>
                </div>
            </div>

            <div class="cta-panel-aside">
                <span class="cta-aside-label">Zadzwoń od razu</span>
                <a href="tel:+48601450146" class="cta-phone">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-phone-volume"></use></svg>601 450 146
                </a>
                <span class="cta-aside-hours">pon.–sob. 6:00–16:00</span>
            </div>
        </div>
    </div>
</section>

