@page
@model IndexModel
@{
    var categoryTicker = Model.MachineCategories.Take(10).ToList();
}

@* ============================ HERO ============================ *@
<section class="home-hero" aria-labelledby="hero-title">
@* Unfingerprinted paths on purpose: the preload in _Layout has to name the
   exact same candidates, and the tag helper does not fingerprint srcset. A
   mismatch there makes the browser fetch the hero twice. *@
    <img src="/images/road-renovation-1.webp"
         srcset="/images/road-renovation-1-1280.webp 1280w,
                 /images/road-renovation-1.webp 1920w"
         sizes="100vw"
         class="home-hero-bg"
         alt="Budowa drogi asfaltowej realizowana przez GAMEX w Olkuszu"
         width="1920" height="600"
         fetchpriority="high" decoding="async" />

    <div class="home-hero-overlay"></div>

    <div class="container">
        <div class="home-hero-content">
            <p class="home-hero-kicker anim-fade-down"><b>1994</b> <span>30 lat na budowach</span></p>

            <h1 id="hero-title" class="anim-hero-title">
                <span class="anim-line">Wypożyczalnia</span>
                <span class="anim-line">maszyn budowlanych</span>
                <span class="anim-line accent">Budowa dróg i chodników</span>
            </h1>

            <p class="lead anim-fade-up anim-d1">
                Wynajmujemy <strong>maszyny budowlane z operatorem</strong> i budujemy
                <strong>drogi, chodniki, parkingi oraz place</strong>. Firma z Olkusza, własny park maszynowy,
                własny transport. Jeździmy po Małopolsce, Śląsku i Świętokrzyskiem.
            </p>

            <div class="home-hero-actions anim-fade-up anim-d2">
                <a asp-page="/Offer/MachineRental/MachineRental" class="btn-gamex btn-primary-gamex btn-lg">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-truck-monster"></use></svg>Zobacz maszyny
                </a>
                <a asp-page="/Contact" asp-fragment="kontakt-formularz" class="btn-gamex btn-secondary-gamex btn-lg">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-file-invoice"></use></svg>Bezpłatna wycena
                </a>
                <a href="tel:+48601450146" class="btn-gamex btn-ghost-gamex btn-lg">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-phone-volume"></use></svg>601 450 146
                </a>
            </div>

            <ul class="home-hero-trust anim-fade-up anim-d3">
                <li><b data-count-to="30" data-count-suffix="+">30+</b><span>lat doświadczenia</span></li>
                <li><b data-count-to="@Model.MachineCount">@Model.MachineCount</b><span>maszyn w wynajmie</span></li>
                <li><b data-count-to="3">3</b><span>województwa</span></li>
                <li><b data-count-to="24" data-count-suffix="h">24h</b><span>podstawienie sprzętu</span></li>
            </ul>
        </div>
    </div>

    <span class="home-hero-scroll" aria-hidden="true"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-chevron-down"></use></svg></span>
</section>

@* ============================ CATEGORY TICKER ============================ *@
<div class="home-ticker" role="complementary" aria-label="Kategorie sprzętu dostępnego w wynajmie">
    <div class="home-ticker-track">
        @for (var pass = 0; pass < 2; pass++)
        {
            @* The second copy exists purely so the scrolling loop has no seam.
               It is hidden from screen readers and taken out of the tab order. *@
            var duplicate = pass == 1;
            <div class="home-ticker-group" aria-hidden="@(duplicate ? "true" : "false")">
                @foreach (var category in categoryTicker)
                {
                    <a asp-page="/Offer/MachineRental/MachineRental"
                       asp-route-category="@category.Key"
                       tabindex="@(duplicate ? "-1" : null)">@category.DisplayName</a>
                }
                <a asp-page="/Offer/Transport/Transport" tabindex="@(duplicate ? "-1" : null)">Transport HDS</a>
                <a asp-page="/Offer/Services/Services" tabindex="@(duplicate ? "-1" : null)">Roboty drogowe</a>
                <a asp-page="/Offer/Services/Services" tabindex="@(duplicate ? "-1" : null)">Kostka brukowa</a>
            </div>
        }
    </div>
</div>

@* ============================ OFFER PILLARS ============================ *@
<section class="section grid-bg" aria-labelledby="oferta-title">
    <div class="container">
        <div class="section-head section-head--center reveal">
            <p class="eyebrow">Co robimy</p>
            <h2 class="section-title" id="oferta-title">Trzy rzeczy, które <em>robimy dobrze</em></h2>
            <p class="section-text">
                Sprzęt, ludzie i transport w jednych rękach. Dlatego przy naszych zleceniach nie ma
                tygodnia przestoju, bo podwykonawca nie podstawił koparki.
            </p>
        </div>

        <div class="pillar-grid reveal reveal-stagger">
            <article class="pillar-card">
                <span class="pillar-index" aria-hidden="true">01</span>
                <span class="pillar-icon"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-truck-monster"></use></svg></span>
                <h3>Wynajem maszyn budowlanych</h3>
                <p>
                    Koparki, koparko-ładowarki, minikoparki, walce, rozkładarki asfaltu, frezarki
                    i zagęszczarki. Zawsze z operatorem, rozliczane od godziny.
                </p>
                <ul class="pillar-tags">
                    <li>z operatorem</li>
                    <li>stawka godzinowa</li>
                    <li>dowóz na budowę</li>
                </ul>
                <a asp-page="/Offer/MachineRental/MachineRental" class="btn-gamex btn-primary-gamex">
                    Sprawdź park maszynowy
                </a>
            </article>

            <article class="pillar-card pillar-card--steel">
                <span class="pillar-index" aria-hidden="true">02</span>
                <span class="pillar-icon"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-road"></use></svg></span>
                <h3>Budowa dróg i chodników</h3>
                <p>
                    Od korytowania i podbudowy po warstwę ścieralną. Kostka brukowa, krawężniki,
                    parkingi, place manewrowe. Dla gmin, firm i osób prywatnych.
                </p>
                <ul class="pillar-tags">
                    <li>drogi i place</li>
                    <li>brukarstwo</li>
                    <li>roboty ziemne</li>
                </ul>
                <a asp-page="/Offer/Services/Services" class="btn-gamex btn-secondary-gamex">
                    Zobacz zakres usług
                </a>
            </article>

            <article class="pillar-card pillar-card--steel">
                <span class="pillar-index" aria-hidden="true">03</span>
                <span class="pillar-icon"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-truck-ramp-box"></use></svg></span>
                <h3>Transport i HDS</h3>
                <p>
                    Kruszywa, piasek, ziemia, gruz. Przewóz maszyn na naczepie niskopodwoziowej
                    i rozładunek dźwigiem tam, gdzie nie wjedzie zwykły samochód.
                </p>
                <ul class="pillar-tags">
                    <li>wywrotki</li>
                    <li>niskopodwoziowy</li>
                    <li>HDS</li>
                </ul>
                <a asp-page="/Offer/Transport/Transport" class="btn-gamex btn-secondary-gamex">
                    Poznaj możliwości floty
                </a>
            </article>
        </div>
    </div>
</section>

@* ============================ EQUIPMENT CATEGORIES ============================ *@
<section class="section section--surface" aria-labelledby="kategorie-title">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Park maszynowy</p>
            <h2 class="section-title" id="kategorie-title">Jaką <em>maszynę</em> chcesz wynająć?</h2>
            <p class="section-text">
                @(Model.MachineCount) maszyn marek JCB, Caterpillar, Komatsu, Bobcat i Manitou.
                Wejdź w kategorię, a zobaczysz konkretne modele z rocznikiem, masą i wyposażeniem.
            </p>
        </div>

        <div class="cat-grid reveal reveal-stagger">
            @foreach (var category in Model.MachineCategories)
            {
                <a class="cat-tile"
                   asp-page="/Offer/MachineRental/MachineRental"
                   asp-route-category="@category.Key"
                   title="Wynajem: @category.DisplayName">
                    <span>@category.DisplayName</span>
                    <span class="cat-count">@category.Machines.Count</span>
                </a>
            }
        </div>

        <div class="mt-4 reveal">
            <a asp-page="/Offer/MachineRental/MachineRental" class="btn-gamex btn-primary-gamex">
                <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-list-check"></use></svg>Cała wypożyczalnia maszyn
            </a>
        </div>
    </div>
</section>

@* ============================ ABOUT ============================ *@
<section id="o-nas" class="home-section-standard" aria-labelledby="o-nas-title">
    <div class="container">
        <div class="row align-items-center g-5 flex-lg-row-reverse">
            <div class="col-lg-6 reveal">
                <p class="eyebrow">O firmie</p>
                <h2 class="section-title" id="o-nas-title">Drogi budujemy <em>od 1994 roku</em></h2>
                <p class="section-text">
                    P.P.U.H. „GAMEX” Grzegorz Żurek to rodzinna firma z Olkusza. Zaczynaliśmy od robót
                    drogowych i przez trzydzieści lat dokupywaliśmy sprzęt, żeby nie zależeć od nikogo:
                    dziś mamy własne koparki, walce, rozkładarki i naczepy do ich wożenia.
                </p>
                <p class="section-text">
                    Ten sam sprzęt <strong>wynajmujemy z operatorem</strong> firmom, które potrzebują
                    maszyny na dwa dni albo na dwa miesiące i nie chcą jej kupować, serwisować
                    i przeglądać przez resztę roku.
                </p>
                <ul class="feature-list feature-list-orange">
                    <li><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-circle-check"></use></svg>Własny park maszynowy</li>
                    <li><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-circle-check"></use></svg>Operatorzy z uprawnieniami</li>
                    <li><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-circle-check"></use></svg>Kontrakty gminne</li>
                    <li><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-circle-check"></use></svg>Własny transport maszyn</li>
                </ul>
                <a asp-page="/Offer/Offer" class="btn-gamex btn-secondary-gamex">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-arrow-right"></use></svg>Poznaj pełną ofertę
                </a>
            </div>
            <div class="col-lg-6 reveal">
                <div class="section-image-wrapper">
                    <img src="~/images/road-renovation-2.webp"
                         class="img-fluid"
                         alt="Ekipa GAMEX podczas modernizacji nawierzchni drogowej w okolicach Olkusza"
                         loading="lazy" decoding="async"
                         width="612" height="409">
                </div>
            </div>
        </div>
    </div>
</section>

