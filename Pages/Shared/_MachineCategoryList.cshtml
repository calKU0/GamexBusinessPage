@model GamexBusinessPage.Models.CategoryLinkViewModel

<div class="machine-category-panel">
    <h2 class="machine-category-title">Kategorie</h2>
    <ul class="machine-category-list">
        @foreach (var link in Model.Links)
        {
            <li>
                <a class="machine-category-link @(link.IsActive ? "is-active" : "")" href="@link.Url">
                    @link.Label
                </a>
            </li>
        }
    </ul>
</div>
