@*
    Ścieżka okruszków. Model to lista par (etykieta, adres); ostatni element bez adresu
    renderowany jest jako pozycja bieżąca. Dane strukturalne BreadcrumbList generują
    modele stron - tutaj odpowiadamy wyłącznie za warstwę wizualną.
*@
@model IReadOnlyList<(string Label, string? Url)>

<nav class="gamex-breadcrumb" aria-label="Ścieżka nawigacji">
    <div class="container">
        <ol class="breadcrumb">
            @foreach (var (label, url) in Model)
            {
                if (string.IsNullOrEmpty(url))
                {
                    <li class="breadcrumb-item active" aria-current="page">@label</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@url">@label</a></li>
                }
            }
        </ol>
    </div>
</nav>
