@model GamexBusinessPage.Pages.Admin.AdminHeaderViewModel

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-bold mb-1">@Model.Title</h1>
        <p class="text-secondary mb-0">@Model.Subtitle</p>
    </div>
    @if (Model.Actions.Count > 0)
    {
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var action in Model.Actions)
            {
                <a asp-page="@action.Page" asp-all-route-data="action.RouteValues" class="@action.CssClass">@action.Text</a>
            }
        </div>
    }
</div>
