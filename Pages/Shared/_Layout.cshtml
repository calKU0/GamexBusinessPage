<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow")">
    <meta name="keywords" content="@ViewData["Keywords"]">
    <meta name="description" content="@ViewData["Description"]">
    <title>@ViewData["Title"]</title>

    <link rel="icon" type="image/x-icon" href="~/images/icon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/images/icon.ico" />

    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"https://gamex-olkusz.pl{Context.Request.Path}")" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"https://gamex-olkusz.pl{Context.Request.Path}")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://gamex-olkusz.pl/images/logo.png")" />
    <meta property="og:site_name" content="Gamex Olkusz" />
    <meta property="og:locale" content="pl_PL" />

    <link rel="preload" href="~/images/road-renovation-1.webp" as="image" fetchpriority="high">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/GamexBusinessPage.styles.css" asp-append-version="true" /> *@
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Schema", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg gamex-navbar fixed-top">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/images/logo.svg" alt="Gamex Olkusz - budowa dróg i wynajem maszyn" class="navbar-logo" />
                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#gamexNavbar"
                        aria-controls="gamexNavbar" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse" id="gamexNavbar">
                    <ul class="navbar-nav ms-auto align-items-center gap-lg-3">

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index" asp-fragment="o-nas">O nas</a>
                        </li>

                        <li class="nav-item dropdown">
                            <div class="dropdown-hover-wrapper">
                                <a class="nav-link dropdown-toggle" asp-page="/Offer/Offer">Oferta</a>

                                <ul class="dropdown-menu dropdown-menu-dark gamex-dropdown">
                                    <li><a class="dropdown-item" asp-page="/Offer/MachineRental/MachineRental">Wypożyczenie maszyn</a></li>
                                    <li><a class="dropdown-item" asp-page="/Offer/Services/Services">Usługi</a></li>
                                    <li><a class="dropdown-item" asp-page="/Offer/Transport/Transport">Transport</a></li>
                                </ul>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Realizations">Realizacje</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link nav-cta" asp-page="/Contact">Kontakt</a>
                        </li>

                        <!-- Dotacje EU Image -->
                        <li class="nav-item nav-dotacje">
                            <a asp-page="/Dotation" class="dotacje-link" aria-label="Dotacje Unii Europejskiej">
                                <img src="~/images/ue_logo.webp" alt="Dotacje Unii Europejskiej" class="dotacje-logo" />
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <div class="a11y-widget" id="a11yWidget">
        <button type="button"
                class="a11y-widget-toggle"
                id="a11yWidgetToggle"
                aria-label="Udogodnienia dostępności"
                aria-controls="a11yWidgetPanel"
                aria-expanded="false">
            <i class="fa-solid fa-universal-access" aria-hidden="true"></i>
        </button>

        <div class="a11y-widget-panel" id="a11yWidgetPanel" role="dialog" aria-label="Udogodnienia dostępności">
            <div class="a11y-widget-header">
                <span>Dostępność</span>
            </div>

            <div class="a11y-widget-group" aria-label="Sterowanie rozmiarem tekstu">
                <button type="button" class="btn btn-sm btn-outline-light a11y-action" data-a11y-action="decrease-font" aria-label="Zmniejsz tekst">A-</button>
                <span class="a11y-font-size-value" id="a11yFontSizeValue">100%</span>
                <button type="button" class="btn btn-sm btn-outline-light a11y-action" data-a11y-action="increase-font" aria-label="Powiększ tekst">A+</button>
            </div>

            <div class="a11y-widget-actions">
                <button type="button" class="btn btn-sm btn-outline-light w-100 a11y-action" data-a11y-action="toggle-contrast">Wysoki kontrast</button>
                <button type="button" class="btn btn-sm btn-outline-light w-100 a11y-action" data-a11y-action="toggle-light">Jasne tło</button>
                <button type="button" class="btn btn-sm btn-outline-light w-100 a11y-action" data-a11y-action="reset">Reset ustawień</button>
            </div>
        </div>
    </div>

    <footer class="gamex-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-info">
                        <img src="~/images/logo.svg" alt="Gamex Olkusz - budowa dróg i wynajem maszyn" class="footer-logo mb-3" />
                        <p class="footer-description">
                            Od 1994 roku budujemy infrastrukturę, która łączy. Profesjonalizm, nowoczesny park maszynowy i trzydziestoletnie doświadczenie w branży drogowej.
                        </p>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h3 class="footer-title">Nawigacja</h3>
                    <ul class="footer-links">
                        <li><a asp-page="/Index">Strona główna</a></li>
                        <li><a asp-page="/Index" asp-fragment="o-nas">O nas</a></li>
                        <li><a asp-page="/Realizations">Realizacje</a></li>
                        <li><a asp-page="/Dotation">Dotacje EU</a></li>
                        <li><a asp-page="/Contact">Kontakt</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h3 class="footer-title">Nasza Oferta</h3>
                    <ul class="footer-links">
                        <li><a asp-page="/Offer/MachineRental/MachineRental">Wynajem maszyn</a></li>
                        <li><a asp-page="/Offer/Services/Services">Usługi</a></li>
                        <li><a asp-page="/Offer/Transport/Transport">Transport</a></li>
                        <li><a asp-page="/Offer/Offer">Pełna oferta</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h3 class="footer-title">Biuro</h3>
                    <ul class="footer-contact">
                        <li>
                            <address class="mb-0">
                                <span class="contact-icon">📍</span>
                                <span>Osiek 233, 32-300 Osiek</span>
                            </address>
                        </li>
                        <li>
                            <span class="contact-icon">📞</span>
                            <a href="tel:601450146">+48 601 450 146</a>
                        </li>
                        <li>
                            <span class="contact-icon">✉️</span>
                            <a href="mailto:gamexolkusz@poczta.fm">gamexolkusz@poczta.fm</a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0">&copy; 2026 Gamex Olkusz. Wszelkie prawa zastrzeżone.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <p class="mb-0 pb-0 footer-author">Projekt i realizacja: <a href="https://portfolio.kkurowski.com" target="_blank" class="text-decoration-none"><strong>Krzysztof Kurowski</strong></a></p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/accessibility-widget.js" asp-append-version="true" defer></script>
    @* <script src="~/js/site.js" asp-append-version="true"></script> *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
