@model GamexBusinessPage.Models.ContactFormViewModel

@using System.Linq

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.IsSuccess == true ? "alert-success" : "alert-danger")" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post" asp-page="/Contact" class="kontakt-form" novalidate autocomplete="on">
    <div class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group col-md-6">
            <label for="contact-name" class="form-label">Imię i nazwisko</label>
            <input asp-for="Input.Name" type="text" id="contact-name" class="form-control" autocomplete="on"/>
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="form-group col-md-6">
            <label for="contact-email" class="form-label">Adres e-mail</label>
            <input asp-for="Input.Email" type="email" id="contact-email" class="form-control" autocomplete="on" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group col-md-6">
            <label for="contact-phone" class="form-label">Telefon</label>
            <input asp-for="Input.Phone" type="tel" id="contact-phone" class="form-control" autocomplete="on" />
            <span asp-validation-for="Input.Phone" class="text-danger"></span>
        </div>

        <div class="form-group col-md-6">
            <label for="contact-subject" class="form-label">Temat</label>
            <input asp-for="Input.Subject" type="text" id="contact-subject" class="form-control" autocomplete="on" />
            <span asp-validation-for="Input.Subject" class="text-danger"></span>
        </div>

        <div class="form-group col-12">
            @{ var selectedMachine = !string.IsNullOrWhiteSpace(Model.SelectedMachineSlug)
                    ? Model.Machines.FirstOrDefault(m => string.Equals(m.Slug, Model.SelectedMachineSlug, StringComparison.OrdinalIgnoreCase))
                    : null; }

            @if (Model.IsMachineLocked && selectedMachine is not null)
            {
                <label for="contact-machine" class="form-label">Maszyna</label>
                <select id="contact-machine" class="form-select" disabled>
                    <option value="@selectedMachine.Slug" selected disabled>@selectedMachine.DisplayName</option>
                </select>
                <input asp-for="Input.Machine" type="hidden" value="@selectedMachine.Slug" />
            }
            else
            {
                <label for="contact-machine" class="form-label">Maszyna (opcjonalnie)</label>
                <div class="custom-select" id="machineSelect">
                    <div class="select-trigger">
                        @(selectedMachine?.DisplayName ?? "Wybierz maszynę")
                    </div>

                    <div class="select-options">
                        @foreach (var group in Model.Machines.GroupBy(m => m.CategoryDisplayName))
                        {
                            <div class="select-group">@group.Key</div>

                            @foreach (var machine in group.OrderBy(m => m.DisplayName))
                            {
                                <div class="select-option"
                                     data-value="@machine.Slug"
                                     data-image="@machine.MainImagePath">
                                    @machine.DisplayName
                                </div>
                            }
                        }
                    </div>

                    <input asp-for="Input.Machine" type="hidden" id="selectedMachine" />
                </div>
            }

            <span asp-validation-for="Input.Machine" class="text-danger"></span>
        </div>

        <div class="form-group col-12">
            <label for="contact-message" class="form-label">Wiadomość</label>
            <textarea asp-for="Input.Message" id="contact-message" rows="5" class="form-control" autocomplete="on"></textarea>
            <span asp-validation-for="Input.Message" class="text-danger"></span>
        </div>

        <div class="d-none" aria-hidden="true">
            <label asp-for="Input.Website">Website</label>
            <input asp-for="Input.Website" autocomplete="off" tabindex="-1" />
        </div>

        <input asp-for="Input.FormToken" type="hidden" />

        <div class="col-12 text-end">
            <button type="submit" class="btn kontakt-submit">
                Wyślij wiadomość
            </button>
        </div>
    </div>
</form>

<img id="machine-hover-preview" />

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const select = document.getElementById("machineSelect");
        if (!select) return;

        const trigger = select.querySelector(".select-trigger");
        const options = select.querySelector(".select-options");

        const preview = document.getElementById("machine-hover-preview");

        /* OPEN / CLOSE */
        trigger.addEventListener("click", function (e) {

            e.stopPropagation();

            const isOpen = options.style.display === "block";

            options.style.display = isOpen ? "none" : "block";

            trigger.classList.toggle("active", !isOpen);
        });

        /* SELECT OPTION */
        options.addEventListener("click", function (e) {

            const option = e.target.closest(".select-option");
            if (!option) return;

            trigger.textContent = option.textContent;

            options.style.display = "none";
            trigger.classList.remove("active");

            /* set hidden input */
            const hidden = document.getElementById("selectedMachine");
            if (!hidden) {
                return;
            }

            hidden.value = option.dataset.value;
        });

        /* CLOSE WHEN CLICK OUTSIDE */
        document.addEventListener("click", function () {

            options.style.display = "none";
            trigger.classList.remove("active");

            if (preview) {
                preview.style.display = "none";
            }
        });

        /* IMAGE HOVER */
        options.addEventListener("mouseover", function (e) {

            const option = e.target.closest(".select-option");
            if (!option || !preview) return;

            const image = option.dataset.image;

            if (!image) {
                preview.style.display = "none";
                return;
            }

            preview.src = image;
            preview.style.display = "block";
        });

        /* IMAGE FOLLOW CURSOR */
        document.addEventListener("mousemove", function (e) {

            if (!preview || preview.style.display !== "block") return;

            preview.style.left = (e.clientX + 20) + "px";
            preview.style.top = (e.clientY + 20) + "px";
        });

    });
</script>
