@page "/kontakt"
@model GamexBusinessPage.Pages.KontaktModel


<div class="kontakt-page">
    <div class="container py-5">
        <section class="kontakt-hero text-center">
            <h1 class="kontakt-title">Kontakt</h1>
            <p class="kontakt-subtitle">
                Skontaktuj się z nami — chętnie odpowiemy na Twoje pytania
            </p>
        </section>

        <section class="kontakt-content">
            <div class="row g-4">

            <!-- CONTACT INFO -->
            <div class="col-lg-4">
                <div class="kontakt-card">
                    <h3>Dane firmy</h3>

                    <p class="firma-name">
                        P.P.U.H. „GAMEX”<br />
                        Grzegorz Żurek
                    </p>

                    <ul class="kontakt-list">
                        <li>📍 Osiek 233, 32-300 Osiek</li>
                        <li>📞 <a href="tel:693223146">693 223 146</a></li>
                        <li>✉️ <a href="mailto:gamexolkusz@poczta.fm">gamexolkusz@poczta.fm</a></li>
                    </ul>

                    <div class="kontakt-meta">
                        <div><strong>NIP:</strong> 6370112668</div>
                        <div><strong>REGON:</strong> 271726184</div>
                    </div>
                </div>
            </div>

            <!-- CONTACT FORM -->
            <div class="col-lg-8" id="kontakt-formularz">
                <div class="kontakt-card">
                    <h3>Formularz kontaktowy</h3>
                    @await Html.PartialAsync("_ContactForm", Model.ContactForm)
                </div>
            </div>
        </div>
        </section>
    </div>

    <section class="kontakt-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2550.7531826499626!2d19.604183876479876!3d50.25919390503484!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4716e4cb3150e78f%3A0xdd51896c72ba8d41!2sPPUH%20Gamex%20mgr.in%C5%BC%20Grzegorz%20%C5%BBurek!5e0!3m2!1spl!2spl!4v1724447808821!5m2!1spl!2spl"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </section>
</div>

@section Schema {
    @if (!string.IsNullOrWhiteSpace(Model.SchemaJson))
    {
        <script type="application/ld+json">
            @Html.Raw(Model.SchemaJson)
        </script>
    }
}
