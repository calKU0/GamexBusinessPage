@page "/realizacje"
@model GamexBusinessPage.Pages.RealizacjeModel

@await Html.PartialAsync("_Breadcrumb", new List<(string, string?)>
{
    ("Strona główna", Url.Page("/Index")),
    ("Realizacje", null)
})

<div class="realizations-page offer-subpage">
    <section class="page-hero page-hero--center">
        <div class="container">
            <p class="eyebrow">Realizacje</p>
            <h1>Galeria <span>w przygotowaniu</span></h1>
            <p class="lead">
                Zdjęć z budowy nazbierało się przez lata sporo, ale trzeba je jeszcze uporządkować.
                Galeria pojawi się tutaj wkrótce. Zanim to nastąpi, chętnie opowiemy o konkretnych
                realizacjach przez telefon albo wyślemy referencje.
            </p>

            <div class="cta-actions">
                <a asp-page="/Contact" class="btn-gamex btn-primary-gamex btn-lg">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-envelope"></use></svg>Poproś o referencje
                </a>
                <a asp-page="/Offer/Offer" class="btn-gamex btn-secondary-gamex btn-lg">
                    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-list-check"></use></svg>Zobacz ofertę
                </a>
            </div>
        </div>
    </section>
</div>

@section Schema {
    @if (!string.IsNullOrWhiteSpace(Model.SchemaJson))
    {
        <script type="application/ld+json">
            @Html.Raw(Model.SchemaJson)
        </script>
    }
}
