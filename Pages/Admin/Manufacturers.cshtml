@page "/admin/manufacturers"
@model GamexBusinessPage.Pages.Admin.ManufacturersModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5 text-light admin-page">
    <partial name="_AdminHeader" model="@(new GamexBusinessPage.Pages.Admin.AdminHeaderViewModel("Producenci", "Pasek „Pracujemy na sprzęcie renomowanych producentów” na stronie głównej.", new[]
    {
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Dodaj producenta", "/Admin/ManufacturerEdit", "btn-gamex btn-primary-gamex"),
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Wróć", "/Admin/Index", "btn-gamex btn-secondary-gamex")
    }))" />

    <partial name="_AdminStatus" model="Model.StatusMessage" />

    <p class="text-secondary mb-4">
        Kolejność na liście to kolejność na stronie. Producent bez logo jest pokazywany samą nazwą.
    </p>

    <div class="table-responsive mb-4">
        <table class="table table-dark table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Jak wygląda na stronie</th>
                    <th>Nazwa</th>
                    <th>Kolejność</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Manufacturers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary">Brak producentów – pasek jest ukryty na stronie.</td>
                    </tr>
                }
                @for (var i = 0; i < Model.Manufacturers.Count; i++)
                {
                    var manufacturer = Model.Manufacturers[i];
                    <tr>
                        <td>
                            <div class="manufacturer-preview partner">
                                <partial name="_ManufacturerMark" model="manufacturer" />
                            </div>
                        </td>
                        <td>
                            @manufacturer.Name
                            @if (!manufacturer.HasLogo)
                            {
                                <span class="badge text-bg-secondary ms-1">bez logo</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Move" class="d-inline-flex gap-1">
                                <input type="hidden" name="name" value="@manufacturer.Name" />
                                <button type="submit" name="direction" value="up" class="btn btn-sm btn-outline-light"
                                        disabled="@(i == 0)" aria-label="Przesuń @manufacturer.Name wyżej"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
                                <button type="submit" name="direction" value="down" class="btn btn-sm btn-outline-light"
                                        disabled="@(i == Model.Manufacturers.Count - 1)" aria-label="Przesuń @manufacturer.Name niżej"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-light" asp-page="/Admin/ManufacturerEdit" asp-route-name="@manufacturer.Name">Edytuj</a>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="name" value="@manufacturer.Name" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-confirm="Usunąć producenta @manufacturer.Name?" onclick="return confirm(this.dataset.confirm);">Usuń</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
