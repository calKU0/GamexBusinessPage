@page "/admin/transport"
@model GamexBusinessPage.Pages.Admin.TransportModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5 text-light admin-page">
    <partial name="_AdminHeader" model="@(new GamexBusinessPage.Pages.Admin.AdminHeaderViewModel("Transport", "Zarządzaj ofertą transportu.", new[]
    {
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Dodaj transport", "/Admin/TransportEdit", "btn-gamex btn-primary-gamex"),
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Wróć", "/Admin/Index", "btn-gamex btn-secondary-gamex")
    }))" />

    <partial name="_AdminStatus" model="Model.StatusMessage" />

    <section class="mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-light">Szukaj</label>
                <input name="TransportSearch" value="@Model.TransportSearch" class="form-control bg-dark text-light border-secondary" placeholder="Pojazd lub opis" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-light">Kategoria</label>
                <select name="TransportCategoryFilter" class="form-select bg-dark text-light border-secondary">
                    <option value="">Wszystkie</option>
                    @foreach (var category in Model.TransportCategoryKeys)
                    {
                        <option value="@category" selected="@(category == Model.TransportCategoryFilter)">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn-gamex btn-secondary-gamex w-100">Filtruj</button>
            </div>
        </form>
    </section>

    <div class="table-responsive mb-4">
        <table class="table table-dark table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kategoria</th>
                    <th>Pojazd</th>
                    <th>Limit</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transports.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary">Brak wyników.</td>
                    </tr>
                }
                else
                {
                    @foreach (var transport in Model.Transports)
                    {
                        <tr>
                            <td>@transport.CategoryKey</td>
                            <td>@transport.Vehicle</td>
                            <td>@(string.IsNullOrWhiteSpace(transport.WeightLimit) ? "-" : transport.WeightLimit)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light" asp-page="/Admin/TransportEdit" asp-route-Category="@transport.CategoryKey" asp-route-Vehicle="@transport.Vehicle">Edytuj</a>
                                <form method="post" asp-page-handler="DeleteTransport" class="d-inline">
                                    <input type="hidden" name="OriginalTransportCategory" value="@transport.CategoryKey" />
                                    <input type="hidden" name="OriginalTransportVehicle" value="@transport.Vehicle" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Usunąć pozycję transportu?');">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
