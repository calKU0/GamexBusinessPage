@page "/admin/machines"
@model GamexBusinessPage.Pages.Admin.MachinesModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5 text-light admin-page">
    <partial name="_AdminHeader" model="@(new GamexBusinessPage.Pages.Admin.AdminHeaderViewModel("Maszyny", "Zarządzaj maszynami do wypożyczenia.", new[]
    {
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Dodaj maszynę", "/Admin/MachineEdit", "btn-gamex btn-primary-gamex"),
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Wróć", "/Admin/Index", "btn-gamex btn-secondary-gamex")
    }))" />

    <partial name="_AdminStatus" model="Model.StatusMessage" />

    <section class="mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-light">Szukaj</label>
                <input name="MachineSearch" value="@Model.MachineSearch" class="form-control bg-dark text-light border-secondary" placeholder="Model, marka, typ" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-light">Kategoria</label>
                <select name="MachineCategoryFilter" class="form-select bg-dark text-light border-secondary">
                    <option value="">Wszystkie</option>
                    @foreach (var category in Model.MachineCategoryKeys)
                    {
                        <option value="@category" selected="@(category == Model.MachineCategoryFilter)">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn-gamex btn-secondary-gamex w-100">Filtruj</button>
            </div>
        </form>
    </section>

    <div class="table-responsive mb-4">
        <table class="table table-dark table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kategoria</th>
                    <th>Maszyna</th>
                    <th>Rok</th>
                    <th>Waga</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Machines.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary">Brak wyników.</td>
                    </tr>
                }
                else
                {
                    @foreach (var machine in Model.Machines)
                    {
                        <tr>
                            <td>@machine.CategoryKey</td>
                            <td>@machine.DisplayName</td>
                            <td>@(machine.ProductionYear?.ToString() ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(machine.Weight) ? "-" : machine.Weight)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light" asp-page="/Admin/MachineEdit" asp-route-Category="@machine.CategoryKey" asp-route-Slug="@machine.Slug">Edytuj</a>
                                <form method="post" asp-page-handler="DeleteMachine" class="d-inline">
                                    <input type="hidden" name="OriginalMachineCategory" value="@machine.CategoryKey" />
                                    <input type="hidden" name="OriginalMachineSlug" value="@machine.Slug" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Usunąć maszynę?');">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
