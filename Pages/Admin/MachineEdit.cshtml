@page "/admin/machines/edit"
@model GamexBusinessPage.Pages.Admin.MachineEditModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5 text-light admin-page">
    <partial name="_AdminHeader" model="@(new GamexBusinessPage.Pages.Admin.AdminHeaderViewModel(Model.IsEdit ? "Edytuj maszynę" : "Dodaj maszynę", "Uzupełnij dane maszyny.", new[]
    {
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Wróć", "/Admin/Machines", "btn-gamex btn-secondary-gamex")
    }))" />

    <div class="card bg-dark border-secondary text-light shadow-sm rounded-4">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" class="row g-3">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" name="OriginalMachineCategory" value="@Model.OriginalMachineCategory" />
                <input type="hidden" name="OriginalMachineSlug" value="@Model.OriginalMachineSlug" />
                <input type="hidden" id="MainImagePath" name="MainImagePath" value="" />
                <input type="hidden" id="MainImageType" name="MainImageType" value="" />

                <div class="col-md-6">
                    <label asp-for="MachineInput.CategoryKey" class="form-label text-light">Kategoria</label>
                    <input asp-for="MachineInput.CategoryKey" class="form-control bg-dark text-light border-secondary" list="machine-categories" />
                    <datalist id="machine-categories">
                        @foreach (var category in Model.MachineCategoryKeys)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    <span asp-validation-for="MachineInput.CategoryKey" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Brand" class="form-label text-light">Marka</label>
                    <input asp-for="MachineInput.Brand" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Model" class="form-label text-light">Model</label>
                    <input asp-for="MachineInput.Model" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Type" class="form-label text-light">Typ</label>
                    <input asp-for="MachineInput.Type" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.ProductionYear" class="form-label text-light">Rok produkcji</label>
                    <input asp-for="MachineInput.ProductionYear" class="form-control bg-dark text-light border-secondary" type="number" min="1900" max="2100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Weight" class="form-label text-light">Waga</label>
                    <input asp-for="MachineInput.Weight" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.RentalOptions" class="form-label text-light">Opcje wynajmu</label>
                    <input asp-for="MachineInput.RentalOptions" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-12">
                    <label asp-for="MachineInput.Notes" class="form-label text-light">Uwagi</label>
                    <textarea asp-for="MachineInput.Notes" class="form-control bg-dark text-light border-secondary" rows="2"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label text-light">Wyposażenie</label>
                    <div data-equipment-list>
                        @for (var i = 0; i < Model.EquipmentItems.Count; i++)
                        {
                            <div class="input-group mb-2" data-equipment-row>
                                <input class="form-control bg-dark text-light border-secondary" name="EquipmentItems[@i]" value="@Model.EquipmentItems[i]" />
                                <button type="button" class="btn btn-outline-danger" data-remove-equipment>Usuń</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-add-equipment>Dodaj pozycję</button>
                </div>

                <div class="col-12">
                    <label class="form-label text-light">Specyfikacja</label>
                    <div data-spec-list>
                        @for (var i = 0; i < Model.SpecificationItems.Count; i++)
                        {
                            <div class="row g-2 align-items-center mb-2" data-spec-row>
                                <div class="col-md-5">
                                    <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[@i].Key" value="@Model.SpecificationItems[i].Key" placeholder="Parametr" />
                                </div>
                                <div class="col-md-5">
                                    <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[@i].Value" value="@Model.SpecificationItems[i].Value" placeholder="Wartość" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger w-100" data-remove-spec>Usuń</button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-add-spec>Dodaj parametr</button>
                </div>

                <!-- Images Section - Simplified -->
                <div class="col-12">
                    <hr class="border-secondary my-4" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-light mb-0">
                            <i class="fas fa-images me-2"></i>Zdjęcia
                        </h5>
                        <div>
                            <label for="ImageFiles" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Dodaj zdjęcia
                            </label>
                            <input asp-for="ImageFiles" class="d-none" 
                                   id="ImageFiles" type="file" accept="image/*" multiple />
                        </div>
                    </div>

                    <div class="row g-3" id="all-images-container">
                        @if (Model.ExistingImages.Count > 0)
                        {
                            @foreach (var image in Model.ExistingImages)
                            {
                                <div class="col-md-3 col-sm-4 col-6" data-image-container="@image.Path" data-image-type="existing">
                                    <div class="card bg-secondary border-0 shadow-sm h-100">
                                        <div class="position-relative">
                                            <img src="@image.Path" class="card-img-top" 
                                                 style="height: 160px; object-fit: cover;" alt="Zdjęcie maszyny" />
                                            @if (image.IsMain)
                                            {
                                                <span class="position-absolute top-0 start-0 badge bg-primary m-2">
                                                    <i class="fas fa-star me-1"></i>Główne
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body p-2">
                                            <div class="d-flex gap-1 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary set-main-btn flex-fill" 
                                                        data-image-path="@image.Path" title="Ustaw jako główne zdjęcie"
                                                        style="display: @(image.IsMain ? "none" : "inline-block")">
                                                    <i class="fas fa-star me-1"></i>Ustaw jako główne
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger delete-image-btn flex-fill" 
                                                        data-image-path="@image.Path" title="Usuń zdjęcie">
                                                    <i class="fas fa-trash me-1"></i>Usuń
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (Model.ExistingImages.Count == 0)
                    {
                        <div class="text-light text-center py-4" id="no-images-message">
                            <i class="fas fa-images fa-2x mb-2"></i>
                            <p class="text-light">Brak zdjęć. Użyj przycisku "Dodaj zdjęcia" aby dodać pierwsze zdjęcie.</p>
                        </div>
                    }

                    <div class="form-text text-muted mt-3">
                        <i class="fas fa-info-circle me-1"></i>
                        Obsługiwane formaty: JPG, PNG, WebP, GIF. Zdjęcia zostaną automatycznie skonwertowane do WebP i skompresowane.
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn-gamex btn-primary-gamex">Zapisz</button>
                    <a asp-page="/Admin/Machines" class="btn-gamex btn-secondary-gamex">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="equipment-template">
    <div class="input-group mb-2" data-equipment-row>
        <input class="form-control bg-dark text-light border-secondary" name="EquipmentItems[__index__]" />
        <button type="button" class="btn btn-outline-danger" data-remove-equipment>Usuń</button>
    </div>
</template>

<template id="spec-template">
    <div class="row g-2 align-items-center mb-2" data-spec-row>
        <div class="col-md-5">
            <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[__index__].Key" placeholder="Parametr" />
        </div>
        <div class="col-md-5">
            <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[__index__].Value" placeholder="Wartość" />
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-danger w-100" data-remove-spec>Usuń</button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const equipmentList = document.querySelector('[data-equipment-list]');
            const specList = document.querySelector('[data-spec-list]');
            const equipmentTemplate = document.getElementById('equipment-template').innerHTML;
            const specTemplate = document.getElementById('spec-template').innerHTML;
            let equipmentIndex = equipmentList ? equipmentList.children.length : 0;
            let specIndex = specList ? specList.children.length : 0;
            let newImageIndex = 0;

            // File input handling for image previews
            const fileInput = document.getElementById('ImageFiles');
            const allImagesContainer = document.getElementById('all-images-container');
            const noImagesMessage = document.getElementById('no-images-message');

            // Track files in an array with their preview IDs
            let selectedFiles = [];

            // Initialize main image tracking on page load
            initializeMainImageTracking();

            function initializeMainImageTracking() {
                // Find the currently main existing image and set hidden fields
                const mainExistingImage = document.querySelector('[data-image-type="existing"] .badge.bg-primary');
                if (mainExistingImage) {
                    const container = mainExistingImage.closest('[data-image-container]');
                    const imagePath = container.getAttribute('data-image-container');
                    document.getElementById('MainImagePath').value = imagePath;
                    document.getElementById('MainImageType').value = 'existing';
                }
            }

            // Add file input change listener
            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    if (e.target.files.length > 0) {
                        handleFileSelection(e.target.files);
                    }
                });
            }

            function handleFileSelection(files) {
                // Hide no images message if it exists
                if (noImagesMessage) {
                    noImagesMessage.style.display = 'none';
                }

                const hasExistingImages = document.querySelectorAll('[data-image-type="existing"]').length > 0;

                // Add new files to our tracking array
                Array.from(files).forEach((file) => {
                    if (file.type.startsWith('image/')) {
                        const previewId = `new-image-${newImageIndex++}`;
                        selectedFiles.push({ file: file, previewId: previewId });

                        // Create preview
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const isFirstImage = selectedFiles.length === 1 && !hasExistingImages && !hasAnyMainImage();
                            const imageCard = createImagePreviewCard(e.target.result, previewId, file.name, isFirstImage);
                            allImagesContainer.appendChild(imageCard);
                        };
                        reader.readAsDataURL(file);
                    }
                });

                // Update the file input with all selected files
                updateFileInput();
            }

            function updateFileInput() {
                const dataTransfer = new DataTransfer();
                selectedFiles.forEach(item => {
                    dataTransfer.items.add(item.file);
                });
                fileInput.files = dataTransfer.files;
            }

            function hasAnyMainImage() {
                return document.querySelector('[data-image-container] .badge.bg-primary, [data-image-container] .badge.bg-success') !== null;
            }

            function createImagePreviewCard(src, imagePath, fileName, isMain = false) {
                const col = document.createElement('div');
                col.className = 'col-md-3 col-sm-4 col-6';
                col.setAttribute('data-image-container', imagePath);
                col.setAttribute('data-image-type', 'preview');

                col.innerHTML = `
                    <div class="card bg-secondary border-0 shadow-sm h-100" style="border: 2px dashed #28a745 !important;">
                        <div class="position-relative">
                            <img src="${src}" class="card-img-top" 
                                 style="height: 160px; object-fit: cover;" alt="Podgląd: ${fileName}" />
                            ${isMain ? '<span class="position-absolute top-0 start-0 badge bg-primary m-2"><i class="fas fa-star me-1"></i>Główne</span>' : ''}
                            <span class="position-absolute top-0 end-0 badge bg-info m-2">Nowe</span>
                        </div>
                        <div class="card-body p-2">
                            <div class="d-flex gap-1 flex-wrap">
                                ${!isMain ? `<button type="button" class="btn btn-sm btn-outline-primary set-main-preview-btn flex-fill" 
                                                    data-image-path="${imagePath}" title="Ustaw jako główne zdjęcie">
                                                <i class="fas fa-star me-1"></i>Ustaw jako główne
                                            </button>` : ''}
                                <button type="button" class="btn btn-sm btn-outline-danger remove-preview-btn flex-fill" 
                                        data-image-path="${imagePath}" title="Usuń z podglądu">
                                    <i class="fas fa-trash me-1"></i>Usuń
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                return col;
            }

            document.addEventListener('click', function (event) {
                if (event.target.matches('[data-add-equipment]')) {
                    event.preventDefault();
                    equipmentList.insertAdjacentHTML('beforeend', equipmentTemplate.replace(/__index__/g, equipmentIndex++));
                }

                if (event.target.matches('[data-add-spec]')) {
                    event.preventDefault();
                    specList.insertAdjacentHTML('beforeend', specTemplate.replace(/__index__/g, specIndex++));
                }

                if (event.target.matches('[data-remove-equipment]')) {
                    event.preventDefault();
                    event.target.closest('[data-equipment-row]')?.remove();
                }

                if (event.target.matches('[data-remove-spec]')) {
                    event.preventDefault();
                    event.target.closest('[data-spec-row]')?.remove();
                }

                // Set main image for preview images
                const setMainPreviewButton = event.target.closest('.set-main-preview-btn');
                if (setMainPreviewButton) {
                    event.preventDefault();
                    const imagePath = setMainPreviewButton.getAttribute('data-image-path');
                    setMainPreviewImage(imagePath);
                }

                // Remove preview image
                const removePreviewButton = event.target.closest('.remove-preview-btn');
                if (removePreviewButton) {
                    event.preventDefault();
                    const previewId = removePreviewButton.getAttribute('data-image-path');
                    const container = removePreviewButton.closest('[data-image-container]');

                    // Remove from selectedFiles array
                    selectedFiles = selectedFiles.filter(item => item.previewId !== previewId);

                    // Update file input
                    updateFileInput();

                    container.remove();

                    setMainImageAfterRemoval(container);

                    // Show no images message if no images left
                    const remainingImages = document.querySelectorAll('[data-image-container]');
                    if (remainingImages.length === 0 && noImagesMessage) {
                        noImagesMessage.style.display = 'block';
                    }
                }

                // Delete existing image functionality
                const deleteButton = event.target.closest('.delete-image-btn');
                if (deleteButton) {
                    event.preventDefault();
                    const imagePath = deleteButton.getAttribute('data-image-path');
                    const category = @Html.Raw(Json.Serialize(Model.Category ?? Model.OriginalMachineCategory));
                    const slug = @Html.Raw(Json.Serialize(Model.Slug ?? Model.OriginalMachineSlug));

                    console.log('Delete button clicked:', { imagePath, category, slug }); // Debug log

                    if (!category || !slug) {
                        showMessage('Błąd: Brak danych kategorii lub nazwy maszyny', 'error');
                        return;
                    }

                    if (confirm('Czy na pewno chcesz usunąć to zdjęcie?')) {
                        deleteImage(imagePath, category, slug, event.target);
                    }
                }

                // Set main existing image functionality
                if (event.target.matches('.set-main-btn')) {
                    event.preventDefault();
                    const imagePath = event.target.getAttribute('data-image-path');

                    setMainExistingImage(imagePath);
                }
            });

            function setMainImageAfterRemoval(removedContainer) {
                const hasMainImage = document.querySelector('[data-image-container] .badge.bg-primary') !== null;
                if (hasMainImage) {
                    return;
                }

                const nextContainer = getNextMainContainer(removedContainer);
                if (!nextContainer) {
                    document.getElementById('MainImagePath').value = '';
                    document.getElementById('MainImageType').value = '';
                    return;
                }

                const nextImagePath = nextContainer.getAttribute('data-image-container');
                const nextImageType = nextContainer.getAttribute('data-image-type');

                if (nextImageType === 'preview') {
                    setMainPreviewImage(nextImagePath);
                } else {
                    setMainExistingImage(nextImagePath);
                }
            }

            function getNextMainContainer(removedContainer) {
                if (!removedContainer) {
                    return document.querySelector('[data-image-container]');
                }

                const nextSibling = removedContainer.nextElementSibling;
                if (nextSibling?.matches('[data-image-container]')) {
                    return nextSibling;
                }

                const previousSibling = removedContainer.previousElementSibling;
                if (previousSibling?.matches('[data-image-container]')) {
                    return previousSibling;
                }

                return document.querySelector('[data-image-container]');
            }


            function setMainExistingImage(imagePath) {
                // Remove main status from all images (existing and preview)
                document.querySelectorAll('[data-image-container] .badge.bg-primary').forEach(badge => badge.remove());
                document.querySelectorAll('[data-image-container] .badge.bg-success').forEach(badge => badge.remove());

                // Show all "Ustaw jako główne" buttons
                document.querySelectorAll('.set-main-btn').forEach(btn => {
                    btn.style.display = 'inline-block';
                });
                document.querySelectorAll('.set-main-preview-btn').forEach(btn => {
                    btn.style.display = 'inline-block';
                });

                // Set selected existing image as main
                const container = document.querySelector(`[data-image-container="${imagePath}"]`);
                if (container) {
                    const imageContainer = container.querySelector('.position-relative');

                    imageContainer.insertAdjacentHTML('beforeend', '<span class="position-absolute top-0 start-0 badge bg-primary m-2"><i class="fas fa-star me-1"></i>Główne</span>');

                    const setMainBtn = container.querySelector('.set-main-btn');
                    if (setMainBtn) {
                        setMainBtn.style.display = 'none';
                    }

                    // Update hidden fields for form submission
                    document.getElementById('MainImagePath').value = imagePath;
                    document.getElementById('MainImageType').value = 'existing';
                }
            }

            function setMainPreviewImage(imagePath) {
                // Remove main status from all images (existing and preview)
                document.querySelectorAll('[data-image-container] .badge.bg-primary').forEach(badge => badge.remove());
                document.querySelectorAll('[data-image-container] .badge.bg-success').forEach(badge => badge.remove());

                // Show all "Ustaw jako główne" buttons
                document.querySelectorAll('.set-main-btn').forEach(btn => {
                    btn.style.display = 'inline-block';
                });
                document.querySelectorAll('.set-main-preview-btn').forEach(btn => {
                    btn.style.display = 'inline-block';
                });

                // Set selected preview image as main
                const container = document.querySelector(`[data-image-container="${imagePath}"]`);
                if (container) {
                    const imageContainer = container.querySelector('.position-relative');

                    imageContainer.insertAdjacentHTML('beforeend', '<span class="position-absolute top-0 start-0 badge bg-primary m-2"><i class="fas fa-star me-1"></i>Główne</span>');

                    const setMainBtn = container.querySelector('.set-main-preview-btn');
                    if (setMainBtn) {
                        setMainBtn.style.display = 'none';
                    }

                    // Update hidden fields for form submission
                    document.getElementById('MainImagePath').value = imagePath;
                    document.getElementById('MainImageType').value = 'preview';
                }
            }

            async function deleteImage(imagePath, category, slug, buttonElement) {
                try {
                    console.log('Deleting image:', { imagePath, category, slug }); // Debug log

                    const formData = new FormData();
                    formData.append('imagePath', imagePath);
                    formData.append('category', category);
                    formData.append('slug', slug);

                    const response = await fetch('/admin/machines/edit?handler=DeleteImage', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const result = await response.json();
                    console.log('Delete response:', result); // Debug log

                    if (result.success) {
                        const container = buttonElement.closest('[data-image-container]');
                        const wasMainImage = container.querySelector('.badge.bg-primary') !== null;

                        container.remove();

                        if (wasMainImage) {
                            setMainImageAfterRemoval(null);
                        }

                        // Show no images message if no images left
                        const remainingImages = document.querySelectorAll('[data-image-container]');
                        if (remainingImages.length === 0 && noImagesMessage) {
                            noImagesMessage.style.display = 'block';
                        }

                        showMessage('Zdjęcie zostało usunięte', 'success');
                    } else {
                        console.error('Delete failed:', result.message);
                        showMessage(result.message || 'Błąd podczas usuwania zdjęcia', 'error');
                    }
                } catch (error) {
                    console.error('Delete error:', error);
                    showMessage('Błąd podczas usuwania zdjęcia: ' + error.message, 'error');
                }
            }

            function showMessage(message, type) {
                const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert ${alertClass} alert-dismissible fade show`;
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

                const container = document.querySelector('.container');
                container.insertBefore(alertDiv, container.firstChild);

                setTimeout(() => {
                    alertDiv.remove();
                }, 3000);
            }
        })();
    </script>
}
