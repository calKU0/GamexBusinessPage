@page "/admin/machines/edit"
@model GamexBusinessPage.Pages.Admin.MachineEditModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5 text-light admin-page">
    <partial name="_AdminHeader" model="@(new GamexBusinessPage.Pages.Admin.AdminHeaderViewModel(Model.IsEdit ? "Edytuj maszynę" : "Dodaj maszynę", "Uzupełnij dane maszyny.", new[]
    {
        new GamexBusinessPage.Pages.Admin.AdminHeaderAction("Wróć", "/Admin/Machines", "btn-gamex btn-secondary-gamex")
    }))" />

    <div class="card bg-dark border-secondary text-light shadow-sm rounded-4">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" class="row g-3">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" name="OriginalMachineCategory" value="@Model.OriginalMachineCategory" />
                <input type="hidden" name="OriginalMachineSlug" value="@Model.OriginalMachineSlug" />
                <input type="hidden" id="MainImagePath" name="MainImagePath" value="" />
                <input type="hidden" id="MainImageType" name="MainImageType" value="" />

                <div class="col-md-6">
                    <label asp-for="MachineInput.CategoryKey" class="form-label text-light">Kategoria</label>
                    <input asp-for="MachineInput.CategoryKey" class="form-control bg-dark text-light border-secondary" list="machine-categories" />
                    <datalist id="machine-categories">
                        @foreach (var category in Model.MachineCategoryKeys)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    <span asp-validation-for="MachineInput.CategoryKey" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Brand" class="form-label text-light">Marka</label>
                    <input asp-for="MachineInput.Brand" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Model" class="form-label text-light">Model</label>
                    <input asp-for="MachineInput.Model" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Type" class="form-label text-light">Typ</label>
                    <input asp-for="MachineInput.Type" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.ProductionYear" class="form-label text-light">Rok produkcji</label>
                    <input asp-for="MachineInput.ProductionYear" class="form-control bg-dark text-light border-secondary" type="number" min="1900" max="2100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineInput.Weight" class="form-label text-light">Waga</label>
                    <input asp-for="MachineInput.Weight" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-12">
                    <label asp-for="MachineInput.Description" class="form-label text-light">Opis (widoczny na karcie maszyny, ważny dla SEO)</label>
                    <textarea asp-for="MachineInput.Description" class="form-control bg-dark text-light border-secondary" rows="4"
                              placeholder="Do czego ta maszyna się nadaje, gdzie się sprawdza, co wyróżnia ten egzemplarz."></textarea>
                </div>

                <div class="col-12">
                    <label asp-for="MachineInput.RentalOptions" class="form-label text-light">Opcje wynajmu</label>
                    <input asp-for="MachineInput.RentalOptions" class="form-control bg-dark text-light border-secondary" />
                </div>
                <div class="col-12">
                    <label asp-for="MachineInput.Notes" class="form-label text-light">Uwagi</label>
                    <textarea asp-for="MachineInput.Notes" class="form-control bg-dark text-light border-secondary" rows="2"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label text-light">Wyposażenie</label>
                    <div data-equipment-list>
                        @for (var i = 0; i < Model.EquipmentItems.Count; i++)
                        {
                            <div class="input-group mb-2" data-equipment-row>
                                <span class="input-group-text bg-dark text-light border-secondary" style="cursor: move;" data-drag-handle>
                                    <i class="fas fa-grip-vertical"></i>
                                </span>
                                <input class="form-control bg-dark text-light border-secondary" name="EquipmentItems[@i]" value="@Model.EquipmentItems[i]" />
                                <button type="button" class="btn btn-outline-danger" data-remove-equipment>Usuń</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-add-equipment>Dodaj pozycję</button>
                </div>

                <div class="col-12">
                    <label class="form-label text-light">Specyfikacja</label>
                    <div data-spec-list>
                        @for (var i = 0; i < Model.SpecificationItems.Count; i++)
                        {
                            <div class="row g-2 align-items-center mb-2" data-spec-row>
                                <div class="col-auto">
                                    <span class="btn btn-dark border-secondary" style="cursor: move;" data-drag-handle>
                                        <i class="fas fa-grip-vertical"></i>
                                    </span>
                                </div>
                                <div class="col-md-5">
                                    <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[@i].Key" value="@Model.SpecificationItems[i].Key" placeholder="Parametr" />
                                </div>
                                <div class="col-md-4">
                                    <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[@i].Value" value="@Model.SpecificationItems[i].Value" placeholder="Wartość" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger w-100" data-remove-spec>Usuń</button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-add-spec>Dodaj parametr</button>
                </div>

                <!-- Images Section - Simplified -->
                <div class="col-12">
                    <hr class="border-secondary my-4" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-light mb-0">
                            <i class="fas fa-images me-2"></i>Zdjęcia
                        </h5>
                        <div>
                            <label for="ImageFiles" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Dodaj zdjęcia
                            </label>
                            <input asp-for="ImageFiles" class="d-none" 
                                   id="ImageFiles" type="file" accept="image/*" multiple />
                        </div>
                    </div>

                    <div class="row g-3" id="all-images-container">
                        @if (Model.ExistingImages.Count > 0)
                        {
                            @foreach (var image in Model.ExistingImages)
                            {
                                <div class="col-md-3 col-sm-4 col-6" data-image-container="@image.Path" data-image-type="existing">
                                    <div class="card bg-secondary border-0 shadow-sm h-100">
                                        <div class="position-relative">
                                            <img src="@image.Path" class="card-img-top" 
                                                 style="height: 160px; object-fit: cover;" alt="Zdjęcie maszyny" />
                                            @if (image.IsMain)
                                            {
                                                <span class="position-absolute top-0 start-0 badge bg-primary m-2">
                                                    <i class="fas fa-star me-1"></i>Główne
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body p-2">
                                            <div class="d-flex gap-1 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary set-main-btn flex-fill" 
                                                        data-image-path="@image.Path" title="Ustaw jako główne zdjęcie"
                                                        style="display: @(image.IsMain ? "none" : "inline-block")">
                                                    <i class="fas fa-star me-1"></i>Ustaw jako główne
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger delete-image-btn flex-fill" 
                                                        data-image-path="@image.Path" title="Usuń zdjęcie">
                                                    <i class="fas fa-trash me-1"></i>Usuń
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (Model.ExistingImages.Count == 0)
                    {
                        <div class="text-light text-center py-4" id="no-images-message">
                            <i class="fas fa-images fa-2x mb-2"></i>
                            <p class="text-light">Brak zdjęć. Użyj przycisku "Dodaj zdjęcia" aby dodać pierwsze zdjęcie.</p>
                        </div>
                    }

                    <div class="form-text text-muted mt-3">
                        <i class="fas fa-info-circle me-1"></i>
                        Obsługiwane formaty: JPG, PNG, WebP, GIF. Zdjęcia zostaną automatycznie skonwertowane do WebP i skompresowane.
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn-gamex btn-primary-gamex">Zapisz</button>
                    <a asp-page="/Admin/Machines" class="btn-gamex btn-secondary-gamex">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="equipment-template">
    <div class="input-group mb-2" data-equipment-row>
        <span class="input-group-text bg-dark text-light border-secondary" style="cursor: move;" data-drag-handle>
            <i class="fas fa-grip-vertical"></i>
        </span>
        <input class="form-control bg-dark text-light border-secondary" name="EquipmentItems[__index__]" />
        <button type="button" class="btn btn-outline-danger" data-remove-equipment>Usuń</button>
    </div>
</template>

<template id="spec-template">
    <div class="row g-2 align-items-center mb-2" data-spec-row>
        <div class="col-auto">
            <span class="btn btn-dark border-secondary" style="cursor: move;" data-drag-handle>
                <i class="fas fa-grip-vertical"></i>
            </span>
        </div>
        <div class="col-md-5">
            <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[__index__].Key" placeholder="Parametr" />
        </div>
        <div class="col-md-4">
            <input class="form-control bg-dark text-light border-secondary" name="SpecificationItems[__index__].Value" placeholder="Wartość" />
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-danger w-100" data-remove-spec>Usuń</button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/admin-image-manager.js"></script>
    <script>
        (function () {
            // Equipment and Specification list handling (Machine-specific)
            const equipmentList = document.querySelector('[data-equipment-list]');
            const specList = document.querySelector('[data-spec-list]');
            const equipmentTemplate = document.getElementById('equipment-template').innerHTML;
            const specTemplate = document.getElementById('spec-template').innerHTML;
            let equipmentIndex = equipmentList ? equipmentList.children.length : 0;
            let specIndex = specList ? specList.children.length : 0;

            // Initialize Image Manager
            const imageManager = new AdminImageManager({
                deleteHandler: '/admin/machines/edit?handler=DeleteImage',
                deleteParams: () => ({
                    category: @Html.Raw(Json.Serialize(Model.Category ?? Model.OriginalMachineCategory)),
                    slug: @Html.Raw(Json.Serialize(Model.Slug ?? Model.OriginalMachineSlug))
                })
            });

            // Initialize drag-and-drop for equipment
            if (equipmentList) {
                new Sortable(equipmentList, {
                    animation: 150,
                    handle: '[data-drag-handle]',
                    ghostClass: 'sortable-ghost',
                    dragClass: 'sortable-drag',
                    onEnd: function () {
                        reindexList(equipmentList, 'EquipmentItems');
                    }
                });
            }

            // Initialize drag-and-drop for specification
            if (specList) {
                new Sortable(specList, {
                    animation: 150,
                    handle: '[data-drag-handle]',
                    ghostClass: 'sortable-ghost',
                    dragClass: 'sortable-drag',
                    onEnd: function () {
                        reindexList(specList, 'SpecificationItems');
                    }
                });
            }

            // Reindex list items after drag
            function reindexList(container, namePrefix) {
                const items = container.querySelectorAll(namePrefix === 'EquipmentItems' ? '[data-equipment-row]' : '[data-spec-row]');
                items.forEach((item, index) => {
                    const inputs = item.querySelectorAll('input');
                    inputs.forEach(input => {
                        if (namePrefix === 'EquipmentItems') {
                            input.name = `${namePrefix}[${index}]`;
                        } else {
                            if (input.placeholder === 'Parametr') {
                                input.name = `${namePrefix}[${index}].Key`;
                            } else {
                                input.name = `${namePrefix}[${index}].Value`;
                            }
                        }
                    });
                });
            }

            // Equipment and Specification event handlers
            document.addEventListener('click', function (event) {
                if (event.target.matches('[data-add-equipment]')) {
                    event.preventDefault();
                    equipmentList.insertAdjacentHTML('beforeend', equipmentTemplate.replace(/__index__/g, equipmentIndex++));
                    reindexList(equipmentList, 'EquipmentItems');
                }

                if (event.target.matches('[data-add-spec]')) {
                    event.preventDefault();
                    specList.insertAdjacentHTML('beforeend', specTemplate.replace(/__index__/g, specIndex++));
                    reindexList(specList, 'SpecificationItems');
                }

                if (event.target.matches('[data-remove-equipment]')) {
                    event.preventDefault();
                    event.target.closest('[data-equipment-row]')?.remove();
                    reindexList(equipmentList, 'EquipmentItems');
                }

                if (event.target.matches('[data-remove-spec]')) {
                    event.preventDefault();
                    event.target.closest('[data-spec-row]')?.remove();
                    reindexList(specList, 'SpecificationItems');
                }
            });
        })();
    </script>
}
