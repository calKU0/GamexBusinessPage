@page "/oferta/wypozyczenie-maszyn/{slug}"
@using GamexBusinessPage.Models
@model GamexBusinessPage.Pages.MachineRental.DetailsModel
@{
    var machine = Model.Machine!;
    var images = machine.OrderedImages;
}

<div class="machine-details-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="machine-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index">Strona główna</a></li>
                <li class="breadcrumb-item"><a asp-page="/Offer/Offer">Oferta</a></li>
                <li class="breadcrumb-item"><a asp-page="/Offer/MachineRental/MachineRental">Wypożyczenie maszyn</a></li>
                <li class="breadcrumb-item active" aria-current="page">@machine.DisplayName</li>
            </ol>
        </nav>

        <div class="row g-4">
            <section class="col-lg-12">
                <header class="machine-details-header">
                    <p class="machine-card-category">@machine.CategoryDisplayName</p>
                    <h1 class="display-6 fw-bold">@machine.DisplayName</h1>
                </header>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <!-- Main Image Container -->
                        <div class="machine-details-media">
                            @if (images.Count > 0)
                            {
                                <div class="swiper machine-gallery-main" id="machine-gallery-main">
                                    <div class="swiper-wrapper">
                                        @for (var i = 0; i < images.Count; i++)
                                        {
                                            var image = images[i];
                                            <div class="swiper-slide">
                                                <img src="@Url.Content(image.Path!)" 
                                                     alt="@machine.DisplayName - @machine.CategoryDisplayName na wynajem w Gamex Olkusz - zdjęcie @(i + 1)" 
                                                     loading="@(i == 0 ? "eager" : "lazy")" />
                                            </div>
                                        }
                                    </div>
                                    @if (images.Count > 1)
                                    {
                                        <div class="swiper-button-next"></div>
                                        <div class="swiper-button-prev"></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="machine-placeholder">Brak zdjęcia</div>
                            }
                        </div>

                        <!-- Thumbnail Strip -->
                        @if (images.Count > 1)
                        {
                            <div class="machine-thumbnail-strip">
                                <div class="swiper machine-gallery-thumbs" id="machine-gallery-thumbs">
                                    <div class="swiper-wrapper">
                                        @for (var i = 0; i < images.Count; i++)
                                        {
                                            var image = images[i];
                                            <div class="swiper-slide">
                                                <img src="@Url.Content(image.Path!)" 
                                                     alt="Miniatura: @machine.DisplayName - zdjęcie @(i + 1)" 
                                                     loading="lazy" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-lg-6">
                        <div class="machine-detail-card">
                            <h2 class="h5 mb-3">Podstawowe informacje</h2>
                            <dl class="row mb-0 machine-basic-info gx-2">
                                @if (!string.IsNullOrWhiteSpace(machine.Brand))
                                {
                                    <dt class="col-sm-4">Marka</dt>
                                    <dd class="col-sm-8">@machine.Brand</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(machine.Model))
                                {
                                    <dt class="col-sm-4">Model</dt>
                                    <dd class="col-sm-8">@machine.Model</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(machine.Type))
                                {
                                    <dt class="col-sm-4">Typ</dt>
                                    <dd class="col-sm-8">@machine.Type</dd>
                                }
                                @if (machine.ProductionYear.HasValue)
                                {
                                    <dt class="col-sm-4">Rok produkcji</dt>
                                    <dd class="col-sm-8">@machine.ProductionYear</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(machine.Weight))
                                {
                                    <dt class="col-sm-4">Waga</dt>
                                    <dd class="col-sm-8">@machine.Weight</dd>
                                }
                            </dl>
                        </div>

                        @if (machine.Specifications.Count > 0)
                        {
                            <section class="machine-parameters-card">
                                <h2 class="h5 mb-3">Parametry</h2>
                                <dl class="machine-parameters-list">
                                    @foreach (var param in machine.Specifications)
                                    {
                                        <dt>@MachineCatalog.GetSpecificationDisplayName(param.Key)</dt>
                                        <dd>@param.Value</dd>
                                    }
                                </dl>
                            </section>
                        }

                        @if (machine.Equipment.Count > 0)
                        {
                            <section class="machine-equipment-card">
                                <h2 class="h5 mb-3">Wyposażenie</h2>
                                <ul class="machine-equipment-list">
                                    @foreach (var element in machine.Equipment)
                                    {
                                        <li>@element</li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(machine.RentalOptions))
                {
                    <section class="machine-section">
                        <h2 class="h4">Opcje wynajmu</h2>
                        <p>@machine.RentalOptions</p>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(machine.Notes))
                {
                    <section class="machine-section">
                        <h2 class="h4">Uwagi</h2>
                        <p>@machine.Notes</p>
                    </section>
                }

                <section class="machine-contact-section">
                    <div class="machine-contact-card">
                        <h2 class="h4">Zapytaj o tę maszynę</h2>
                        @await Html.PartialAsync("_ContactForm", Model.ContactForm)
                    </div>
                </section>
            </section>
        </div>
    </div>
</div>

@section Schema {
    @if (!string.IsNullOrWhiteSpace(Model.SchemaJson))
    {
        <script type="application/ld+json">
            @Html.Raw(Model.SchemaJson)
        </script>
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Initializing Swiper gallery...');

            // Wait for DOM to be fully rendered
            setTimeout(function() {
                let galleryThumbs = null;

                // Initialize thumbnail swiper only if thumbnails exist
                const thumbsElement = document.querySelector('.machine-thumbnail-strip .machine-gallery-thumbs');
                if (thumbsElement) {
                    console.log('Initializing thumbnails...');
                    galleryThumbs = new Swiper('.machine-thumbnail-strip .machine-gallery-thumbs', {
                        spaceBetween: 10,
                        slidesPerView: 'auto',
                        freeMode: true,
                        watchSlidesProgress: true,
                        allowTouchMove: true,
                        nested: false,
                        resistance: false
                    });
                    console.log('Thumbnails initialized');
                }

                // Initialize main gallery
                const mainElement = document.getElementById('machine-gallery-main');
                if (mainElement) {
                    console.log('Initializing main gallery...');
                    const swiperConfig = {
                        spaceBetween: 0,
                        slidesPerView: 1,
                        effect: 'slide',
                        speed: 800,
                        loop: @(images.Count > 1 ? "true" : "false"),
                        keyboard: {
                            enabled: true,
                            onlyInViewport: true,
                        },
                        a11y: {
                            prevSlideMessage: 'Poprzednie zdjęcie',
                            nextSlideMessage: 'Następne zdjęcie',
                        },
                        nested: false
                    };

                    @if (images.Count > 1) {
                    <text>
                    // Add autoplay for multiple images
                    swiperConfig.autoplay = {
                        delay: 5000,
                        disableOnInteraction: false
                    };

                    // Add navigation
                    swiperConfig.navigation = {
                        nextEl: '.machine-gallery-main .swiper-button-next',
                        prevEl: '.machine-gallery-main .swiper-button-prev',
                    };

                    // Add thumbs connection if thumbnails exist
                    if (galleryThumbs) {
                        swiperConfig.thumbs = {
                            swiper: galleryThumbs,
                        };
                    }
                    </text>
                    }

                    const galleryMain = new Swiper('#machine-gallery-main', swiperConfig);
                    console.log('Main gallery initialized successfully');
                }
            }, 150);
        });
    </script>
}
