@page "/oferta"
@model GamexBusinessPage.Pages.OfertaModel


<div class="oferta-page">
    <div class="container py-5">
        <header class="oferta-hero text-center">
            <h1 class="display-4 fw-bold">Nasza <span>Oferta</span></h1>
            <p class="lead mx-auto" style="max-width: 700px;">
                Dostarczamy kompleksowe rozwiązania dla budownictwa drogowego.
                Wybierz interesujący Cię obszar, aby dowiedzieć się więcej.
            </p>
        </header>

        <section class="pb-5">
            <div class="row g-4 justify-content-center">

                <div class="col-lg-4 col-md-6">
                    <div class="oferta-card card-machinery">
                        <div class="card-content">
                            <div class="card-icon">🚜</div>
                            <h3>Wypożyczenie maszyn</h3>
                            <p>Profesjonalny sprzęt budowlany wraz z doświadczoną obsługą operatorską dla Twojej inwestycji.</p>
                            <a asp-page="/Offer/MachineRental/MachineRental" class="btn-gamex btn-primary-gamex">
                                Zobacz maszyny
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="oferta-card card-roads">
                        <div class="card-content">
                            <div class="card-icon">🛣️</div>
                            <h3>Usługi</h3>
                            <p>Kompleksowa budowa i modernizacja nawierzchni bitumicznych, chodników oraz infrastruktury towarzyszącej.</p>
                            <a asp-page="/Offer/Services/Services" class="btn-gamex btn-secondary-gamex">
                                Sprawdź szczegóły
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="oferta-card card-transport">
                        <div class="card-content">
                            <div class="card-icon">🚚</div>
                            <h3>Transport</h3>
                            <p>Transport materiałów sypkich, maszyn i ładunków HDS z szybką realizacją na terenie Małopolski.</p>
                            <a asp-page="/Offer/Transport/Transport" class="btn-gamex btn-secondary-gamex">
                                Zobacz opcje
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>
</div>

