@page "/dotacja"
@model GamexBusinessPage.Pages.DotacjaModel
@{
}
<div class="container py-5">
    <section class="dotacje-hero container-fluid">
        <div class="container text-center">
            <img src="~/images/fundusze-europejskie.webp"
                 alt="Fundusze Europejskie"
                 class="dotacje-hero-logo" />

            <h1 class="dotacje-title">
                Projekt FEMP.08.07-IP.01-0145/23
            </h1>

            <p class="dotacje-subtitle">
                Transformacja przedsiębiorstwa GAMEX
            </p>
        </div>
    </section>

    <section class="dotacje-content container">
        <div class="dotacje-card">

            <p>
                Firma <strong>Grzegorz Żurek Przedsiębiorstwo Produkcyjno-Usługowo-Handlowe „Gamex”</strong>
                uzyskała dotację z Unii Europejskiej na realizację projektu
                pn. <strong>„Transformacja przedsiębiorstwa GAMEX”</strong>.
                Projekt realizowany jest w celu wzmocnienia potencjału przedsiębiorstwa
                oraz wdrożenia innowacyjnych rozwiązań.
            </p>

            <h2>Zakres projektu</h2>
            <p>
                Zadania planowane w projekcie obejmują nabycie środków trwałych, w tym m.in.:
            </p>

            <ul class="dotacje-list">
                <li>koparki gąsienicowe i kołowe</li>
                <li>minikoparki oraz midi koparki</li>
                <li>walec drogowy</li>
                <li>układarki mas bitumicznych (mała i duża)</li>
                <li>ładowarki, wozidła oraz miniładowarki</li>
                <li>sprzęt specjalistyczny: frezarka, przesiewacz, sprężarka</li>
            </ul>

            <h2>Cele projektu</h2>
            <p>
                Celem projektu jest rozwój działalności przedsiębiorstwa GAMEX,
                zwiększenie jego konkurencyjności oraz dostosowanie do wyzwań
                związanych z transformacją gospodarki.
            </p>

            <p>
                Projekt zakłada dywersyfikację działalności, wdrożenie nowych usług
                oraz utworzenie <strong>2 nowych miejsc pracy (2 EPC)</strong>.
            </p>

            <h2>Nowa usługa</h2>
            <p>
                W wyniku realizacji projektu zostanie wdrożona nowa usługa
                krótkoterminowego wynajmu maszyn budowlanych wraz z operatorem,
                rozliczana według stawki godzinowej.
            </p>

            <h2>Grupy docelowe</h2>
            <ul class="dotacje-list">
                <li>firmy budowlane ogólnego zakresu</li>
                <li>firmy specjalistyczne (instalacje, konstrukcje, wykończenia)</li>
                <li>firmy remontowo-naprawcze</li>
                <li>firmy drogowe i infrastrukturalne</li>
                <li>firmy zajmujące się wyburzeniami</li>
            </ul>

            <div class="dotacje-values">
                <div>
                    <span>Wartość projektu</span>
                    <strong>10 663 983,52 PLN</strong>
                </div>
                <div>
                    <span>Dofinansowanie UE</span>
                    <strong>6 105 023,49 PLN</strong>
                </div>
            </div>

            <p class="dotacje-hashtags">
                #FunduszeUE &nbsp; #FunduszeEuropejskie
            </p>
        </div>
    </section>
</div>